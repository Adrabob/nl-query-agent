# systemd unit for the NL Query Agent (FastAPI + static frontend).
# Target OS: Oracle Linux 9 (default user is "opc").
# Install on the VM:
#   sudo cp deploy/nlquery.service /etc/systemd/system/nlquery.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nlquery
# Adjust User / WorkingDirectory / uv path if the VM layout differs.

[Unit]
Description=NL Query Agent (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/Hackathon
Environment=HOME=/home/opc
Environment=PATH=/home/opc/.local/bin:/usr/local/bin:/usr/bin:/bin
# uv reads .env via the app (config.load_dotenv) from WorkingDirectory.
ExecStart=/home/opc/.local/bin/uv run uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
